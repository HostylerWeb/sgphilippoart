# Database (Docker Compose uses POSTGRES_* below)
POSTGRES_USER=sgphilippoart
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sgphilippoart
DATABASE_URL="postgresql://sgphilippoart:change-me-strong-password@localhost:5432/sgphilippoart?schema=public"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="SG Philippo Art"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Studio email — sender for customers and recipient for admin notifications
STUDIO_EMAIL="contact@sgphilippoart.com"

# SMTP (required for production — logs to console in dev without SMTP_HOST)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="SG Philippo Art"

# Seed admin user (admin@sgphilippoart.com) — development only
ADMIN_SEED_PASSWORD="change-me-before-seeding"

# Mobile / tunnel dev — add tunnel hostname (e.g. my-app.loca.lt) comma-separated
# ALLOWED_DEV_ORIGINS="my-app.loca.lt"
